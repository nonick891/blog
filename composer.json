{
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.8"
    },
    "scripts": {
        "lint": "phpcs core/ app/",
        "fix": "phpcbf core/ app/",
        "post-install-cmd": [
            "git config core.hooksPath githooks || true"
        ]
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "fakerphp/faker": "^1.24",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
