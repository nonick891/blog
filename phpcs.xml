<?xml version="1.0"?>
<ruleset name="MyProjectStandard">
    <description>Project-specific rules based on PSR-12</description>

    <!-- Reference the built-in PSR-12 standard -->
    <rule ref="PSR12"/>

    <!-- Define which directories to check -->
    <file>framework/</file>
    <file>app/</file>

    <!-- Show progress and colors in terminal -->
    <arg value="p"/>
    <arg name="colors"/>
</ruleset>